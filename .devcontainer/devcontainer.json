// Dev container for the wps backend workspace.
// See https://aka.ms/devcontainer.json for format details.
{
  "name": "wps",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  // The osgeo/gdal image ships no SSH server, which the GitHub Codespaces CLI
  // needs in order to open a terminal.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  // API (uvicorn) and web (vite) respectively.
  "forwardPorts": [8080, 3000],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspace/backend/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.cwd": "/workspace/backend",
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
